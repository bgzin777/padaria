# ============================================
# PADARIA DO BRUNAO — Backend Environment
# Copie este arquivo para .env e preencha
# ============================================

# --- MongoDB ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=padaria_brunao

# --- CORS ---
# Em produção, coloque a URL do frontend (ex.: https://padariabrunao.com)
CORS_ORIGINS=*

# --- JWT ---
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-aleatorio-de-64-caracteres

# --- Admin inicial (criado no primeiro start) ---
ADMIN_EMAIL=dono@padariabrunao.com
ADMIN_PASSWORD=troqueestaSenhaJa2026
ADMIN_NAME=Bruno

# --- URL pública do backend (usada pelo webhook do Mercado Pago) ---
# Em dev local, use ngrok: https://xxxxx.ngrok.io
PUBLIC_BACKEND_URL=https://api.padariabrunao.com

# --- Storage de imagens ---
# "local" = grava em backend/uploads/ (default fora do Emergent)
# "emergent" = Object Storage da plataforma Emergent (requer EMERGENT_LLM_KEY)
STORAGE_TYPE=local

# --- Emergent (opcional; só se rodar dentro da plataforma Emergent) ---
EMERGENT_LLM_KEY=

# ============================================
# 💰 PIX — Mercado Pago (opcional, mas recomendado)
# ============================================
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Sem estas vars, PIX cai como "pending" e o dono confirma manualmente.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ============================================
# 🤖 Telegram — notificações grátis pro dono (recomendado)
# ============================================
# BOT_TOKEN: crie um bot no @BotFather (Telegram)
# CHAT_ID: use @userinfobot para descobrir o seu Id
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ============================================
# 📱 WhatsApp — Z-API (opcional, pago ~R$79/mês)
# ============================================
# Painel: https://app.z-api.io
# Sem estas vars, os avisos ao cliente via WhatsApp são MANUAIS
# (botões wa.me no painel — funciona 100% grátis mas o dono precisa clicar).
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
OWNER_WHATSAPP=
